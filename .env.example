# Copy to .env and change what you need. Every value has a default in app/config.py.

# --- vector store: qdrant | chroma. Set *_URL for a server, otherwise *_LOCAL_PATH is used. ---
VECTOR_BACKEND=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant_local
CHROMA_URL=
CHROMA_LOCAL_PATH=./data/chroma_local
COLLECTION_NAME=documents

# --- chunk store used by BM25 ---
CORPUS_PATH=./data/corpus.jsonl

# --- embeddings: local (hashing, offline) | openai ---
EMBEDDING_BACKEND=local
EMBEDDING_DIMENSION=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- chunking and hybrid search ---
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60

# --- reranker: local (TF-IDF) | cross_encoder (needs sentence-transformers) ---
RERANKER_BACKEND=local
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- answer generation: local (extractive) | openai | anthropic ---
DEFAULT_LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
GENERATION_MAX_TOKENS=800

# --- citation checking: lexical | nli (needs sentence-transformers) | llm (needs an API provider) ---
CITATION_CHECKER=lexical
NLI_MODEL=cross-encoder/nli-deberta-v3-small
# CITATION_SUPPORT_THRESHOLD=0.15
